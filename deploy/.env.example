# Tambahkan ke .env di folder compose server (di samping variabel lama DB_USER, DB_PASSWORD, DB_NAME, dst.)
# DB_NAME tetap = database aplikasi lama (sumber migrasi). Aplikasi puskesmas memakai
# DB_USER/DB_PASSWORD yang sama (user postgres) dengan database terpisah di bawah ini.

# Lokasi repo sikap-blud-puskesmas di server
PUSKESMAS_SRC=/home/linux/sikap-blud-new/sikap-blud-puskesmas

# Nama database aplikasi puskesmas (opsional, default: sikap_blud_new)
# PUSKESMAS_DB_NAME=sikap_blud_new

# Secret cookie sesi, min. 32 karakter (openssl rand -hex 32)
PUSKESMAS_SESSION_SECRET=
